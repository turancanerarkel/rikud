<script>
    /**
     * Bugün 10:00 ve dün 10:00 değerlerine göre günlük değişimi hesaplar ve
     * .daily-change-badge içine yazar. Kart başına bir badge vardır.
     * Baz anahtar önceliği: .sat -> .sat_discount -> .al
     */

    //  setInterval(async () => {
    //     try {
    //         const res = await fetch('/Home/LoginControl', { cache: 'no-store' });

    //         // Sunucu yönlendirme yaptıysa otomatik logout
    //         if (res.redirected) {
    //             window.location.href = res.url;
    //             return;
    //         }

    //         // JSON döndüyse
    //         const data = await res.json();
    //         if (data && data.redirect) {
    //             window.location.href = data.redirect;
    //         }
    //     } catch (err) {
    //         console.log('Login kontrol hatası:', err);
    //     }
    // }, 10000); // 10 saniye


    // Oturum kontrolü: 30 sn'de bir Home/SessionPing'e POST.
    // Bu cihaz limit nedeniyle düşürüldüyse sunucu Logout'a -> Login'e yönlendirir;
    // fetch redirect'i sessizce takip eder, o yüzden res.redirected'ı yakalayıp sayfayı biz yönlendiriyoruz.
    setInterval(async () => {
        try {
            const res = await fetch('@Url.Action("SessionPing", "Home")', { method: 'POST', cache: 'no-store' });
            if (res.redirected) {
                window.location.href = res.url;
            }
        } catch (err) {
            console.log('SessionPing hatası:', err);
        }
    }, 30000);


    function istanbulAt10(date) {
      // Sunucu Türkiye saatinde, UTC düzeltmesi gerekmez
      return new Date(date.getFullYear(), date.getMonth(), date.getDate(), 10, 0, 0, 0);
    }

    function formatPercent(p) {
      if (!isFinite(p)) return "0%";
      const v = Math.round(p * 10) / 10;
      if (v === 0) return "0%";
      return (v > 0 ? `+${v}%` : `${v}%`);
    }

    function applyBadge(el, percent) {
      el.classList.remove("positive", "negative","normal");
      const txt = formatPercent(percent);
      el.textContent = txt;
      if (txt === "0%") el.classList.add("normal");
      if (percent > 0) el.classList.add("positive");
      else if (percent < 0) el.classList.add("negative");
    }

    // Karttaki anahtar önceliğini bulur: .sat -> .sat_discount -> .al
    function resolveBaseKeyForCard(cardEl) {
      const sat = cardEl.querySelector('.price-value[data-key$=".sat"]');
      if (sat) return sat.getAttribute('data-key');
      const satd = cardEl.querySelector('.price-value[data-key$=".sat_discount"]');
      if (satd) return satd.getAttribute('data-key');
      const al = cardEl.querySelector('.price-value[data-key$=".al"]');
      if (al) return al.getAttribute('data-key');
      return null;
    }

    /**
     * /Home/PricesAt10 endpoint'inden günlük değişim verilerini çeker.
     * Endpoint JSON döner: { gram: {pct,sign}, ataceyrek:{...}, ... }
     */
    async function getDailyChangeData() {
      try {
        const res = await fetch("/Home/PricesAt10");
        if (!res.ok) throw console.log("Sunucu hatası");
        const data = await res.json();
        if (!data.ok) console.log("Veri bulunamadı");
        return data;
      } catch (err) {
        console.log("PricesAt10 yüklenemedi:", err);
        return null;
      }
    }

    async function updateDailyBadgesForAllCards() {
      const data = await getDailyChangeData();
      if (!data) return;

      const cards = document.querySelectorAll(".price-card");
      const keyList = [
        "gram",
        "ataceyrek",
        "atayarim",
        "atalira",
        "bilezik",
        "ziyceyrek",
        "ziyyarim",
        "ziylira"
      ];

      for (const card of cards) {
        const badge = card.querySelector(".daily-change-badge");
        if (!badge) continue;

        // Kartın ürününü bul (örnek: gram, ataceyrek ...)
        const baseKey = keyList.find(k =>
          card.querySelector(`[data-key^="${k}."]`)
        );

        if (!baseKey || !data[baseKey]) {
          applyBadge(badge, 0);
          continue;
        }

        const pct = data[baseKey].pct ?? 0;
        const sign = data[baseKey].sign;

        badge.classList.remove("positive", "negative","normal");
        badge.textContent =
          (pct > 0 ? "+" : pct < 0 ? "" : "") + pct.toFixed(2) + "%";

        if (sign === "positive") badge.classList.add("positive");
        else if (sign === "negative") badge.classList.add("negative");
      }
    }

    // Sayfa yüklenince 1 kez çalışsın
    document.addEventListener("DOMContentLoaded", updateDailyBadgesForAllCards);

    // Dilersen her 10 dakikada bir yenile
    // setInterval(updateDailyBadgesForAllCards, 600000);
</script>

