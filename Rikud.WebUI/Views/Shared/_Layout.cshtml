@{
    Layout = null;
}

@{
    var duyuruListesi = (List<string>)ViewBag.DuyuruList;
}

<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rize Kuyumcular Derneği - Fiyat Panosu</title>
    <link rel="shortcut icon" href="~/assets/images/rikud_logo.png">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/icons/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- datepicker css -->
    <link rel="stylesheet" href="~/assets/libs/flatpickr/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">

    <style>
        :root {
            --bg-primary: #0a0a0f;
            --bg-secondary: #1a1a2e;
            --bg-card: #16213e;
            --bg-card-hover: #1e2749;
            --accent-primary: #ffd700;
            --accent-secondary: #ffed4e;
            --accent-success: #00ff88;
            --accent-danger: #ff4757;
            --text-primary: #ffffff;
            --text-secondary: #a8b2d1;
            --text-muted: #6c7293;
            --border-color: #2d3748;
            --shadow-primary: 0 25px 50px rgba(0, 0, 0, 0.4);
            --shadow-card: 0 15px 35px rgba(0, 0, 0, 0.2);
            --radius-small: 12px;
            --radius-medium: 16px;
            --radius-large: 24px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #0a0a0f 0%, #1a1a2e 50%, #16213e 100%);
            background-attachment: fixed;
            color: var(--text-primary);
            line-height: 1.6;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .main-container {
            min-height: 100vh;
            padding: 2rem;
            position: relative;
        }

        /* Header Styles */
        .header {
            background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-card) 100%);
            border-radius: var(--radius-large);
            padding: 2rem;
            margin-bottom: 2rem;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-card);
            backdrop-filter: blur(20px);
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: 1rem;
            width: 100%;
        }

        .logo {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(255, 215, 0, 0.3);
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }

        .company-info h1 {
            font-size: clamp(1.8rem, 4vw, 3rem);
            font-weight: 800;
            margin: 0;
            background: linear-gradient(135deg, var(--text-primary), var(--accent-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .company-info .subtitle {
            color: var(--text-secondary);
            font-size: clamp(0.9rem, 2vw, 1.1rem);
            margin-top: 0.5rem;
        }

        .header-announcements {
            display: none;
            width: 100%;
            margin-top: 0.5rem;
            flex: 1;
            margin-right: 1rem;
            min-width: 0;
        }

            .header-announcements .ticker {
                background: rgba(255, 255, 255, 0.05);
                border-radius: var(--radius-small);
                padding: 0.5rem;
                border: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                gap: 1rem;
                width: 100%;
                min-width: 800px;
            }

            .header-announcements .ticker-label {
                font-size: 0.8rem;
                padding: 0.3rem 0.6rem;
                white-space: nowrap;
            }

            .header-announcements .ticker-viewport {
                height: 2rem;
                flex: 1;
                min-width: 0;
                width: 100%;
            }

        .status-bar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 0.5rem;
            flex-shrink: 0;
        }

        .status-item {
            background: rgba(255, 255, 255, 0.05);
            padding: 0.75rem 1.5rem;
            border-radius: var(--radius-medium);
            border: 1px solid var(--border-color);
            font-weight: 500;
        }

            .status-item.highlight {
                background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
                color: #000;
                font-weight: 700;
            }

        /* Announcement Ticker */
        .announcement-container {
            background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-secondary) 100%);
            border-radius: var(--radius-medium);
            padding: 1.5rem;
            margin-bottom: 2rem;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-card);
        }

        .ticker {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .ticker-label {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: #000;
            padding: 0.5rem 1rem;
            border-radius: var(--radius-small);
            font-weight: 700;
            font-size: 0.9rem;
            white-space: nowrap;
        }

        .ticker-viewport {
            flex: 1;
            position: relative;
            height: 2.5rem;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.03);
            border-radius: var(--radius-small);
            border: 1px solid var(--border-color);
        }

        .ticker-item {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 100%;
            display: flex;
            align-items: center;
            padding: 0 1rem;
            transform: translateY(100%);
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            font-weight: 500;
            font-size: 1.1rem;
        }

            .ticker-item.show {
                transform: translateY(0);
            }

            .ticker-item.exit {
                transform: translateY(-100%);
            }

        /* Price Cards */
        .price-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .price-card {
            background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-secondary) 100%);
            border-radius: var(--radius-large);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-card);
            overflow: hidden;
            transition: var(--transition);
            position: relative;
        }

            .price-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-primary);
                border-color: var(--accent-primary);
            }

            .price-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
            }

        .card-header {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: #000;
            padding: 1.5rem;
            font-weight: 800;
            font-size: clamp(1.2rem, 2.5vw, 1.8rem);
            text-align: center;
            letter-spacing: 0.5px;
        }

        .card-content {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            min-height: 240px;
        }

        .price-column {
            text-align: center;
            padding: 1rem 0.5rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: var(--radius-medium);
            border: 1px solid var(--border-color);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 0;
            overflow: visible;
            flex: 1;
        }

            .price-column:hover {
                background: rgba(255, 255, 255, 0.05);
                border-color: var(--accent-primary);
            }

        .price-label {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 0.8rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        .price-value {
            font-size: clamp(1.6rem, 3.5vw, 2.8rem);
            font-weight: 900;
            color: var(--text-primary);
            line-height: 1;
            margin: 0;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
            white-space: nowrap;
            overflow: visible;
            word-break: keep-all;
            min-width: fit-content;
            transition: color 0.3s ease, transform 0.2s ease;
        }

            .price-value.price-up {
                color: var(--accent-success);
            }

            .price-value.price-down {
                color: var(--accent-danger);
            }

            .price-value.up {
                color: var(--accent-success);
            }

            .price-value.down {
                color: var(--accent-danger);
            }

        .price-change {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 0.2rem;
            opacity: 0;
            transform: translateY(-10px);
            transition: all 0.4s ease;
            min-height: 0;
            height: 0;
            overflow: hidden;
            white-space: nowrap;
        }

            .price-change.show {
                opacity: 1;
                transform: translateY(0);
                height: auto;
                min-height: auto;
            }

            .price-change.up {
                color: var(--accent-success);
            }

            .price-change.down {
                color: var(--accent-danger);
            }

        .arrow {
            font-size: 0.9rem;
            font-weight: bold;
        }

            .arrow.up {
                color: var(--accent-success);
            }

            .arrow.down {
                color: var(--accent-danger);
            }


        .price-column.discount {
            position: relative;
        }

        .daily-change-badge {
            position: absolute;
            top: -8px;
            left: -8px;
            color: #fff;
            padding: 0.3rem 0.6rem;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 800;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
            z-index: 10;
        }

            .daily-change-badge.normal {
                background: linear-gradient(135deg, grey, grey);
            }

            .daily-change-badge.positive {
                background: linear-gradient(135deg, #00ff88, #00cc6a);
            }

            .daily-change-badge.negative {
                background: linear-gradient(135deg, #ff4757, #ff3742);
            }

        .price-column.sell-highlight {
            border: 2px solid #FCFCFC;
            background: rgba(252, 252, 252, 0.05);
            opacity: 1;
        }

            .price-column.sell-highlight .price-value {
                color: #FCFCFC;
            }

            .price-column.sell-highlight .price-label {
                color: #FCFCFC;
            }

        .header {
            position: relative;
        }
        /* mutlak konum için konteyner */
        .company-badge {
            position: absolute;
            top: clamp(10px, 3.6vw, 50px);
            right: clamp(10px, 2vw, 28px);
            white-space: nowrap;
            z-index: 10;
        }

        body.fullscreen-mode .company-badge {
            position: absolute;
            top: 14.0rem; /* Duyuru satırı hizası */
            right: 2rem; /* Sağ kenara sabit */
            transform: translateY(0);
        }

        /* Footer */
        .footer {
            background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-card) 100%);
            border-radius: var(--radius-large);
            padding: 1.5rem 2rem;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-card);
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .cproserver-link {
            color: var(--accent-primary);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

            .cproserver-link:hover {
                color: var(--accent-secondary);
                text-decoration: underline;
            }

        /* Fullscreen Button */
        .fullscreen-btn {
            position: fixed;
            top: 1rem;
            right: 1rem;
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            z-index: 1000;
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
        }

            .fullscreen-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(255, 215, 0, 0.4);
            }

        .fullscreen-icon {
            font-size: 1.2rem;
            color: #000;
            font-weight: bold;
        }

        /* Fullscreen mode styles */
        body.fullscreen-mode .announcement-container,
        body.fullscreen-mode .footer {
            display: none !important;
        }

        body.fullscreen-mode .header-announcements {
            display: block !important;
            flex: 3;
            max-width: none;
            width: 100%;
            margin-right: 2rem;
            margin-top: 3rem;
        }

            body.fullscreen-mode .header-announcements .ticker {
                min-width: 1200px;
                border: none;
                background: transparent;
            }

            body.fullscreen-mode .header-announcements .ticker-viewport {
                border: none;
                background: transparent;
            }


        body.fullscreen-mode .main-container {
            padding: 1rem;
        }

        body.fullscreen-mode .logo {
            width: 120px;
            height: 120px;
        }

        body.fullscreen-mode .logo-section {
            align-items: center;
        }

        body.fullscreen-mode .company-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            height: 120px;
            margin-top: 6rem;
        }

        body.fullscreen-mode .price-grid {
            margin-bottom: 0;
        }

        body.fullscreen-mode .gecmis-link {
            display: none !important;
        }

        /* Responsive Design */
        @@media (max-width: 1400px) {
            .price-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 1.2rem;
            }
        }

        @@media (max-width: 1000px) {
            .price-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem;
            }
        }

        @@media (max-width: 768px) {
            .main-container {
                padding: 1rem;
            }

            .price-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .card-content {
                flex-direction: column;
                gap: 1rem;
                padding: 1.5rem;
            }

            .price-column {
                padding: 1rem 0.5rem;
            }

            .price-value {
                font-size: clamp(1.8rem, 5vw, 2.5rem);
            }

            .status-bar {
                justify-content: center;
            }

            .ticker {
                flex-direction: column;
                align-items: stretch;
                gap: 0.5rem;
            }

            .ticker-label {
                align-self: flex-start;
            }
            /* Duyuru kutusu mobilde kesin gözüksün */
            .announcement-container {
                display: block !important;
            }
                /* Yükseklik içerik kadar olsun */
                .announcement-container .ticker-viewport {
                    height: auto;
                    margin-top: 7px;
                }
                /* Animasyonu iptal et, normal konumda dursun */
                .announcement-container .ticker-item {
                    position: relative;
                    transform: none !important;
                    transition: none !important;
                }
                    /* İKİNCİ ticker (next) HER ZAMAN GİZLİ */
                    .announcement-container .ticker-item + .ticker-item {
                        display: none !important;
                    }
        }

        @@media (max-width: 480px) {
            .logo-section {
                flex-direction: column;
                text-align: center;
                gap: 1rem;
            }

            .price-value {
                font-size: 2.2rem;
            }

            .price-column {
                padding: 0.8rem 0.3rem;
            }
        }

        /* Animation for price updates */
        @@keyframes priceUpdate {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes priceFlash {
            0% {
                background-color: transparent;
            }

            50% {
                background-color: rgba(255, 255, 255, 0.1);
            }

            100% {
                background-color: transparent;
            }
        }

        .price-value.updated {
            animation: priceUpdate 0.6s ease-in-out;
        }

        .price-column.flash {
            animation: priceFlash 1s ease-in-out;
        }

        /* Loading animation */
        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }
        }

        .loading {
            animation: pulse 1.5s ease-in-out infinite;
        }
    </style>
</head>
<body>
    <div class="main-container">
        <!-- Header Section -->
        <header class="header">
            <div class="logo-section">
                <div class="logo">
                    <img src="~/assets/images/rikud_logo.png" alt="RİK Logo" class="logo-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="logo-fallback" style="display: none; width: 100%; height: 100%; background: linear-gradient(135deg, #FFD700, #FFEC4A); border-radius: 50%; align-items: center; justify-content: center; font-weight: 900; font-size: 1.5rem; color: #000;">RİK</div>
                </div>
                <div class="company-info">
                    <h1>Rize Kuyumcular Derneği</h1>
                    <div class="subtitle">
                        Tavsiye edilen fiyatlar • <span id="currentTime"></span> • Son güncelleme: <span id="lastUpdate">—</span>
                    </div>
                    <!-- Announcements in header for fullscreen mode -->
                    <div class="header-announcements">
                        <div class="ticker">
                            <span class="ticker-label">📢 Duyuru</span>
                            <div class="ticker-viewport">
                                <div class="ticker-item" id="tickerCurrentHeader"></div>
                                <div class="ticker-item" id="tickerNextHeader"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="status-item highlight company-badge">
                    @ViewBag.CompanyName
                </div>
            </div>

        </header>

        <!-- Fullscreen Button -->
        <button class="fullscreen-btn" id="fullscreenBtn">
            <span class="fullscreen-icon">⛶</span>
        </button>

        <!-- Announcement Section -->
        <div class="announcement-container">
            <div class="ticker">
                <span class="ticker-label">📢 Duyuru</span>
                <div class="ticker-viewport">
                    <div class="ticker-item" id="tickerCurrent"></div>
                    <div class="ticker-item" id="tickerNext"></div>
                </div>
            </div>
        </div>

        <!-- Price Cards Section -->
        @RenderBody()

        <!-- Footer Section -->
        <footer class="footer">
            <div class="footer-content">
                <div>
                    © <span id="currentYear"></span> Rize Kuyumcular Derneği - Tüm hakları saklıdır.
                    <a class="cproserver-link gecmis-link" href="@Url.Action("DovizGecmisi", "Home")" target="_blank" rel="noopener">
                        Geçmiş Kayıtlar
                    </a>

                </div>



                <div>
                    <a href="@Url.Action("Logout", "User")" class="btn btn-outline-warning rounded-pill shadow-sm px-4 py-2">
                        <i class="bi bi-door-closed me-2"></i> Çıkış Yap
                    </a>
                    Powered by
                    <a href="https://www.cproserver.com" target="_blank" class="cproserver-link">cproserver</a>
                </div>
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- datepicker js -->
    <script src="~/assets/libs/flatpickr/flatpickr.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <script>
        // DOM Elements
        const currentTimeEl = document.getElementById('currentTime');
        const lastUpdateEl = document.getElementById('lastUpdate');
        const currentYearEl = document.getElementById('currentYear');
        const fullscreenBtn = document.getElementById('fullscreenBtn');
        const tickerCurrent = document.getElementById('tickerCurrent');
        const tickerNext = document.getElementById('tickerNext');
        const tickerCurrentHeader = document.getElementById('tickerCurrentHeader');
        const tickerNextHeader = document.getElementById('tickerNextHeader');

        // Utility Functions
        const pad = (n) => n.toString().padStart(2, '0');

        // Time Update Function
        function updateTime() {
          const now = new Date();
          const timeString = `${pad(now.getDate())}.${pad(now.getMonth() + 1)}.${now.getFullYear()} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
          currentTimeEl.textContent = timeString;
          currentYearEl.textContent = now.getFullYear();
        }

        // Fullscreen Functionality
        fullscreenBtn.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen?.();
            document.body.classList.add('fullscreen-mode');
            fullscreenBtn.querySelector('.fullscreen-icon').textContent = '⛶';
          } else {
            document.exitFullscreen?.();
            document.body.classList.remove('fullscreen-mode');
            fullscreenBtn.querySelector('.fullscreen-icon').textContent = '⛶';
          }
        });

        // Listen for fullscreen changes
        document.addEventListener('fullscreenchange', () => {
          if (!document.fullscreenElement) {
            document.body.classList.remove('fullscreen-mode');
          }
        });


        const announcements = @Html.Raw(Json.Serialize(duyuruListesi));

        // Announcement Ticker
        // const announcements = [
        //   "Bugün 12:30 ve 16:30'da fiyat güncellemesi yapılacaktır.",
        //   "Hafta içi 10:00-18:30 arası açıktır.",
        //   "Üyelik belgelerini sistemden güncelleyiniz.",
        //   "Yeni fiyat güncellemeleri için sistem takibini yapın.",
        //   "Müşteri hizmetleri 7/24 aktif durumda."
        // ];

        let currentAnnouncementIndex = 0;
        let isTickerBusy = false;

        function updateTicker() {
          if (isTickerBusy) return;

          isTickerBusy = true;
          const nextText = announcements[currentAnnouncementIndex % announcements.length];
          currentAnnouncementIndex++;

          tickerNext.textContent = nextText;
          tickerNext.style.transform = 'translateY(100%)';

          if (tickerNextHeader) {
            tickerNextHeader.textContent = nextText;
            tickerNextHeader.style.transform = 'translateY(100%)';
          }

          // Force reflow
          void tickerNext.offsetHeight;

          tickerCurrent.classList.remove('show');
          tickerCurrent.classList.add('exit');
          tickerNext.classList.add('show');

          if (tickerCurrentHeader && tickerNextHeader) {
            tickerCurrentHeader.classList.remove('show');
            tickerCurrentHeader.classList.add('exit');
            tickerNextHeader.classList.add('show');
          }

          setTimeout(() => {
            tickerCurrent.textContent = tickerNext.textContent;
            tickerCurrent.className = 'ticker-item show';
            tickerNext.className = 'ticker-item';

            if (tickerCurrentHeader && tickerNextHeader) {
              tickerCurrentHeader.textContent = tickerNextHeader.textContent;
              tickerCurrentHeader.className = 'ticker-item show';
              tickerNextHeader.className = 'ticker-item';
            }

            isTickerBusy = false;
          }, 600);
        }

        function startTicker() {
          if (!tickerCurrent || !tickerNext) return;

          tickerCurrent.textContent = announcements[0];
          tickerCurrent.classList.add('show');

          if (tickerCurrentHeader) {
            tickerCurrentHeader.textContent = announcements[0];
            tickerCurrentHeader.classList.add('show');
          }

          currentAnnouncementIndex = 1;

          setInterval(updateTicker, 4000);
        }

        // Price Update System
        const priceHistory = {};

        function parsePrice(priceStr) {
          return parseFloat(priceStr.replace(/\./g, '').replace(',', '.'));
        }

        function formatPrice(price) {
          return price.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        }

         function updatePrice(key, newPrice) {
          const priceElement = document.querySelector(`[data-key="${key}"]`);
          if (!priceElement) return;

          const columnElement = priceElement.closest('.price-column');
          const oldPrice = parsePrice(priceElement.textContent);
          const newPriceNum = parsePrice(newPrice);

          // Yön belirle
          const isUp = newPriceNum > oldPrice;
          const isDown = newPriceNum < oldPrice;

          // Eğer aynıysa işlem yapma
          if (newPriceNum === oldPrice) return;

          // Renk class'larını güncelle
          priceElement.classList.remove('price-up', 'price-down');
          if (isUp) priceElement.classList.add('price-up');
          else if (isDown) priceElement.classList.add('price-down');

          // Değeri güncelle
          priceElement.textContent = formatPrice(newPriceNum);

          // Sütunu flash animasyonu ile parlat
          if (columnElement) {
            columnElement.classList.add('flash');
            setTimeout(() => columnElement.classList.remove('flash'), 1000);
          }

          // 7 saniye sonra renkleri sıfırla
          setTimeout(() => {
            priceElement.classList.remove('price-up', 'price-down');
          }, 7000);

          // History güncelle
          priceHistory[key] = newPriceNum;

          // Eğer bu bir satış fiyatıysa (%5 indirimli olanı da güncelle)
          if (key.endsWith('.sat') && !key.includes('_discount')) {
            const discountKey = key.replace('.sat', '.sat_discount');
            const discountPrice = (newPriceNum * 0.95).toFixed(2);
            const discountElement = document.querySelector(`[data-key="${discountKey}"]`);
            if (discountElement) {
              discountElement.textContent = formatPrice(parseFloat(discountPrice));
            }
          }
        }


        function animatePriceUpdate(element) {
          element.classList.add('updated');
          setTimeout(() => {
            element.classList.remove('updated');
          }, 600);
        }

        // API Integration Functions
             async function fetchPrices() {
          try {
            const res = await fetch('@Url.Action("LivePrices", "Home")', { cache: 'no-store' });
            const raw = await res.json();
            if (!raw || raw.ok !== true) return;

            // Server’dan gelen alanları, senin updateAllPrices’in beklediği formata çeviriyoruz.
            const payload = {
              gram:       { buy: fmtTR(raw.gram.al),       sell: fmtTR(raw.gram.sat) },
              ataceyrek:  { buy: fmtTR(raw.ataceyrek.al),  sell: fmtTR(raw.ataceyrek.sat) },
              atayarim:   { buy: fmtTR(raw.atayarim.al),   sell: fmtTR(raw.atayarim.sat) },
              atalira:    { buy: fmtTR(raw.atalira.al),    sell: fmtTR(raw.atalira.sat) },
              bilezik:    { buy: fmtTR(raw.bilezik.al),    sell: fmtTR(raw.bilezik.sat) },
              ziyceyrek:  { buy: fmtTR(raw.ziyceyrek.al),  sell: fmtTR(raw.ziyceyrek.sat) },
              ziyyarim:   { buy: fmtTR(raw.ziyyarim.al),   sell: fmtTR(raw.ziyyarim.sat) },
              ziylira:    { buy: fmtTR(raw.ziylira.al),    sell: fmtTR(raw.ziylira.sat) },
            };

            updateAllPrices(payload); // mevcut fonksiyonun
          } catch (err) {
            console.error('Fiyat güncelleme hatası:', err);
          }
        }

          const fmtTR = n => n.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');

        function updateAllPrices(priceData) {
          Object.keys(priceData).forEach(key => {
            const data = priceData[key];
            updatePrice(`${key}.al`, data.buy, data.buy > (priceHistory[`${key}.al`] || 0));
            updatePrice(`${key}.sat`, data.sell, data.sell > (priceHistory[`${key}.sat`] || 0));
          });

          lastUpdateEl.textContent = new Date().toLocaleString('tr-TR');
        }
        // Initialize
        updateTime();
        setInterval(updateTime, 1000);
        startTicker();
        // simulatePriceUpdates();
        fetchPrices();

        // API Integration - 3 saniyede bir fiyat kontrolü (ConsoleApp yazma aralığı ile aynı)
        setInterval(fetchPrices, 3000);

        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => {
          if (e.key === 'F11') {
            e.preventDefault();
            fullscreenBtn.click();
          }
        });
    </script>
</body>
</html>