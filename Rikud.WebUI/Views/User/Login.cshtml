@model LoginVm
@inject IOptions<ReCAPTCHASettings> GoogleReCAPTCHA

@{
    Layout = null;
}

<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rize Kuyumcular Derneği - Fiyat Panosu</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --bg-dark: #1a1a1f; /* Dark blue-grey background */
            --panel-bg: #2d2d35; /* Panel background */
            --accent-yellow: #ffd700; /* Yellow accent */
            --accent-green: #00ff88; /* Green accent */
            --text-white: #ffffff; /* White text */
            --text-light: #b0b0b0; /* Light grey text */
            --error: #ff4444; /* Error color */
        }

        * {
            font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body {
            background: var(--bg-dark);
            min-height: 100vh;
            display: grid;
            place-items: center;
            margin: 0;
        }

        .login-container {
            max-width: 400px;
            width: 100%;
            padding: 20px;
        }

        .logo-section {
            text-align: center;
            margin-bottom: 40px;
        }

        .logo {
            width: 80px;
            height: 80px;
            background: var(--accent-yellow);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            font-size: 24px;
            font-weight: bold;
            color: var(--bg-dark);
        }

        .brand-title {
            color: var(--text-white);
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .brand-subtitle {
            color: var(--text-light);
            font-size: 14px;
        }

        .login-panel {
            background: var(--panel-bg);
            border-radius: 16px;
            padding: 40px 30px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        }

        .login-title {
            color: var(--text-white);
            font-size: 20px;
            font-weight: 600;
            text-align: center;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            color: var(--text-light);
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            color: var(--text-white);
            padding: 12px 16px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background: rgba(255, 255, 255, 0.15);
                border-color: var(--accent-yellow);
                box-shadow: 0 0 0 2px rgba(255, 215, 0, 0.2);
                color: var(--text-white);
            }

            .form-control::placeholder {
                color: var(--text-light);
                opacity: 0.7;
            }

        .btn-login {
            background: var(--accent-yellow);
            color: var(--bg-dark);
            border: none;
            border-radius: 8px;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s ease;
            margin-top: 10px;
        }

            .btn-login:hover {
                background: #ffed4e;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(255, 215, 0, 0.3);
            }

        .error-alert {
            background: var(--error);
            color: var(--text-white);
            border: none;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .remember-forgot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .form-check {
            color: var(--text-light);
        }

        .form-check-input:checked {
            background-color: var(--accent-yellow);
            border-color: var(--accent-yellow);
        }

        .forgot-link {
            color: var(--accent-green);
            text-decoration: none;
            font-size: 14px;
        }

            .forgot-link:hover {
                color: var(--accent-green);
                text-decoration: underline;
            }

        .copyright {
            text-align: center;
            margin-top: 30px;
            color: var(--text-light);
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="login-container">

        <div class="login-panel">
            <div class="login-title">Hoş Geldiniz</div>

            @* Hata mesajı alanı *@
            @if (ViewBag.LoginError != null)
            {
                <div class="error-alert" id="errorBox">@ViewBag.LoginError</div>
            }

            <form asp-action="Login" asp-controller="User" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Username" class="form-label">Kullanıcı Adı</label>
                    <input asp-for="Username" class="form-control" placeholder="Kullanıcı adınızı girin" required />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password" class="form-label">Şifre</label>
                    <input asp-for="Password" class="form-control" placeholder="Şifrenizi girin" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div id="div_Recaptcha" class="g-recaptcha" data-sitekey="@GoogleReCAPTCHA.Value.SiteKey"></div>
                    <span class="text-danger small">@Html.ValidationMessage("Recaptcha")</span>
                </div>

                <button type="submit" class="btn btn-login w-100">
                    <i class="bi bi-box-arrow-in-right me-2"></i>GİRİŞ YAP
                </button>
            </form>
        </div>

        <div class="copyright">
            © 2025 Tüm hakları saklıdır.
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</body>
</html>
