@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>


@section Scripts {

    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>

    <script>

      
        debugger;

        const socket = io("wss://hrmsocketonly.haremaltin.com:443", {
            transports: ["websocket"],
            reconnection: false // Test için reconnect kapalı
        });

        console.log("Bağlantı deneniyor...", "data");

        // 1. Bağlantı Sağlandı
        socket.on("connect", () => {
            console.log("BAĞLANDI! Socket ID: " + socket.id, "success");
        });

        // 2. Bağlantı Hatası
        socket.on("connect_error", (err) => {
            console.log("HATA OLUŞTU: " + err.message, "error");
            console.error(err);
        });

        // 3. Veri Geldiğinde (price_changed eventi)
        socket.on("price_changed", (data) => {
            // Gelen veriyi JSON string'e çevirip ekrana bas
            console.log("VERİ GELDİ: " + JSON.stringify(data).substring(0, 120) + "...", "data");
        });

        // 4. Bağlantı Koptu
        socket.on("disconnect", (reason) => {
            console.log("Bağlantı koptu: " + reason, "error");
        });
    </script>


}