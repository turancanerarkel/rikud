@model LoginVm
@inject IOptions<ReCAPTCHASettings> GoogleReCAPTCHA

@{
    Layout = "_LayoutLogin";
}

<div class="d-flex flex-column min-vh-100 px-3 pt-4">
    <div class="row justify-content-center my-auto">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="text-center mb-4">
                <a href="/">
                    <img src="~/assets/images/rikud_logo.png" alt="Rikud" height="70" />
                </a>
            </div>

            <div class="card">
                <div class="card-body p-4">
                    <div class="text-center mt-2">
                        <h5 class="text-primary">Hoşgeldiniz !</h5>
                        <p class="text-muted">RIKUD Admin panele giriş yapın</p>
                    </div>

                    <div class="p-2 mt-4">
                        <form asp-action="Login" asp-controller="User" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                            <div class="mb-3">
                                <label asp-for="Username" class="form-label"></label>
                                <input asp-for="Username" class="form-control" placeholder="Kullanıcı adı" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" placeholder="Şifre" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <div id="div_Recaptcha" class="g-recaptcha" data-sitekey="@GoogleReCAPTCHA.Value.SiteKey"></div>
                                <span class="text-danger small">@Html.ValidationMessage("Recaptcha")</span>
                            </div>

                            <div class="mt-3 text-end">
                                <button class="btn btn-primary w-sm" type="submit">Giriş Yap</button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="text-center text-muted p-4">
                <p class="text-white-50">
                    © <script>document.write(new Date().getFullYear())</script>
                    <a href="https://www.cproserver.com" target="_blank">cproserver</a> tarafından
                    <i class="mdi mdi-heart text-danger"></i> hazırlanmıştır
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <partial name="_ValidationScriptsPartial" />
}