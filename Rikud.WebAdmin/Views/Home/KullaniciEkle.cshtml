@model Rikud.DLL.Models.Users

@{
    ViewData["Title"] = "KullaniciEkle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Kullanici Ekle</h1>


<div class="row">
    <div class="col-xl-7 col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0"></h4>
                <a asp-action="Kullanicilar" class="btn btn-sm btn-outline-secondary">Listeye Dön</a>
            </div>

            <div class="card-body">
                <form asp-action="KullaniciEkle" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label">Kullanıcı Adı</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RolId" class="form-label">Rol</label>
                            <select asp-for="RolId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Roller, "Id", "RolAdi"))">
                                <option disabled value="">-- Rol Seçin --</option>
                            </select>
                            <span asp-validation-for="RolId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SessionCount" class="form-label">Oturum Sayısı</label>
                            <input asp-for="SessionCount" type="number" class="form-control" />
                            <span asp-validation-for="SessionCount" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">Şifre</label>
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label">Firma Adı</label>
                            <input asp-for="CompanyName" type="text" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Active" />
                                <label class="form-check-label" asp-for="Active"></label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            </div>

            <div class="card-footer text-muted small">
                Zorunlu alanları doldurduktan sonra <strong>Kaydet</strong>’e basın.
            </div>
        </div>
    </div>
</div>

