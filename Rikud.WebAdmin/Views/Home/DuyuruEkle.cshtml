@model Rikud.WebAdmin.ViewModels.AnnouncementsVm

@{
    ViewData["Title"] = "Duyuru Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Yeni Duyuru Ekle</h5>
            </div>

            <div class="card-body">
                <form asp-action="DuyuruEkle" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-3">
                        <label asp-for="DuyuruText" class="form-label fw-semibold"></label>
                        <textarea asp-for="DuyuruText" class="form-control" rows="4" placeholder="Duyuru metnini buraya yazın..."></textarea>
                        <span asp-validation-for="DuyuruText" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Duyurular" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Listeye Dön
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Duyuru Ekle
                        </button>
                    </div>
                </form>
            </div>
        </div>
       
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
