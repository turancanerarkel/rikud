@{
    Layout = "_Layout";
}

@{
    var dovizModlari = (List<ExchangeModeValues>)ViewBag.DovizModlari;
}


<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-10"><h4 class="card-title mb-0">Doviz Modlari</h4></div>
                   
                        <div class="col-md-2">
                            <a type="button" class="btn btn-success waves-effect waves-light" asp-action="DovizModuEkle" asp-controller="Home">Yeni Mod Değeri Ekle</a>
                        </div>
                </div>
                <div class="col-md-2">
                </div>
            </div><!-- end card header -->
            <div class="card-body">
                <div id="table-gridjs"></div>
            </div>

            <div class="row col-12 mb-5">
                <div class="col-10">
                </div>
                <div class="col-2">
                    <button onclick="SırayiKaydet()" class="btn btn-primary waves-effect waves-light">Varsayılan Kaydet</button>
                </div>
            </div>

        </div>
    </div>

</div>


@section scripts {
    <script>
            $(document).ready(function() {

                    LoadUserGrid(0);
                    $('.gridjs-search-input').attr("placeholder", "Ara...")
                });

                function LoadUserGrid() {

                    new gridjs.Grid(
                        {
                            language: {
                                pagination: {
                                    previous: 'Geri',
                                    next: 'Ileri',
                                    showing: '\n',
                                    to: 'ile',
                                    of: 'arası',
                                    results: 'Sonuc(lar)',
                                }
                            },
                            columns: [{ name: "", sort: { enabled: !1 }, formatter: function(e) { return gridjs.html('<i class="bx bx-money"></i>') } }
                            , {name: "Varsayilan", width: "120px"
                    }
                                , "Mod"
                                , "Gram Alis"
                                , "Gram Satis"
                                , "A. Ceyrek Alis"
                                , "A. Ceyrek Satis"
                                , "A. Yarim Alis"
                                , "A. Yarim Satis"
                                , "A. Lira Alis"
                                , "A. Lira Satis"
                                , "22 Ayar Alis"
                                , "22 Ayar Satis"
                                , "Z.Ceyrek Alis"
                                , "Z.Ceyrek Satis"
                                , "Z.Yarim Alis"
                                , "Z.Yarim Satis"
                                , "Z.Lira Alis"
                                , "Z.Lira Satis"
                                , "Kayıt Tarihi"
                                , "Kayıt Yapan"
                                , "#"
                            ]
                            , pagination: { limit: 10 }, sort: !0, search: !0,
                            server: {
                                url: '/Home/_ModeDovizList',
                                then: data => data.map(item => [
                                gridjs.html('<i class="bx bx-money"></i>'),
                                                gridjs.html(`
          <input
            type="checkbox"
                class="form-check-input single-check"
        name="defaultMode"
            name="flexRadioDefault_"
            id="chk_${item.id}"
            ${item.selectedMod ? "checked" : ""}
          />
        `),
                                item.modAdi,                                                   
                                item.gramAltinAlis,
                                item.gramAltinSatis,
                                item.ataCeyrekAlis,
                                item.ataCeyrekSatis,
                                item.ataYarimAlis,
                                item.ataYarimSatis,
                                item.ataLiraAlis,
                                item.ataLiraSatis,
                                item.yirmiIkiAyarAlis,
                                item.yirmiIkiAyarSatis,
                                item.ziynetCeyrekAlis,
                                item.ziynetCeyrekSatis,
                                item.ziynetYarimAlis,
                                item.ziynetYarimSatis,
                                item.ziynetLiraAlis,
                                item.ziynetLiraSatis,
                                new Date(item.createdDate).toLocaleString('tr-TR'),
                                item.createdByStr,
                                gridjs.html(
                                `<a href='@Url.Action("DovizModDuzenle", "Home")?Id=${item.id}' class='btn btn-warning waves-effect waves-light'>Güncelle</a>
        <button type='button'
                class='btn btn-primary waves-effect waves-light ms-2'
                onclick='confirmDelete(${item.id}, ${item.modAdi})'>
            Sil
        </button>`
                                )                                                                
                            ]),
                                total: data => data.count
                            }
                        }).render(document.getElementById("table-gridjs"));

                }

                        function confirmDelete(id, modAdi) {

                    // Normal kullanıcılar için onay sor
                    Swal.fire({
                        title: 'Emin misiniz?',
                        text: 'Bu modu ( '+modAdi+' ) silmek istediğinizden emin misiniz?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Evet, sil',
                        cancelButtonText: 'Vazgeç'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Silme isteğini yönlendir
                            window.location.href = '@Url.Action("DovizModSil", "Home")?Id=' + id;
                        }
                    });
                }


                function SırayiKaydet() {

            siraList = [];
            var siraList2 = @Html.Raw(Json.Serialize(dovizModlari));
            for (var i = 0; i < siraList2.length; i++) {
                siraList.push(Gen_DuyuruItem(siraList2[i].id, document.getElementById("chk_" + siraList2[i].id).checked));
            }


            $.ajax({
                url: "@Url.Action("ModDefaultKaydet")",
                type: "POST",
                contentType: 'application/json charset=utf-8',
                data: JSON.stringify({
                    siraList: siraList
                }),
                success: function (res) {
                    if (res != "") {
                        Swal.fire({ title: "Bilgi", text: res, icon: "warning", confirmButtonColor: "#3980c0" })
                    }
                    else {
                        window.location.reload();

                    }
                }
            });
        }

        function Gen_DuyuruItem(id, value) {
            return {
                Id: id
                , DefaultChecked: value
            };
        }


               const container = document.getElementById('table-gridjs');

        // 1) İlk yüklemede en az bir tanesi seçili kalsın
        function ensureOneChecked() {
          const checks = container.querySelectorAll('input.single-check[name="defaultMode"]');
          if (checks.length === 0) return;
          const anyChecked = Array.from(checks).some(c => c.checked);
          if (!anyChecked) checks[0].checked = true;  // hiç yoksa ilkini seç
        }

        // 2) Tek seçim ve boş kalmayı engelle
        container.addEventListener('change', (e) => {
          const t = e.target;
          if (!(t instanceof HTMLInputElement)) return;
          if (t.type !== 'checkbox' || t.name !== 'defaultMode') return;

          const group = container.querySelectorAll('input.single-check[name="defaultMode"]');

          if (t.checked) {
            // Bu seçildiyse diğerlerini kapat
            group.forEach(el => { if (el !== t) el.checked = false; });
          } else {
            // Bu kaldırıldı, başka seçili yoksa tekrar aç (boş kalmasın)
            const anyChecked = Array.from(group).some(el => el.checked);
            if (!anyChecked) t.checked = true;
          }

          // Burada seçili id'yi alıp backend’e gönderebilirsin:
          // const selectedId = Array.from(group).find(el => el.checked)?.value;
          // saveDefaultMode(selectedId);
        });

        // Grid hazır olduğunda çağır (ör. grid.render() bittikten sonra)
        // Grid.js kullanıyorsan:
        // grid.on('ready', ensureOneChecked);
        // Eğer event yoksa küçük bir setTimeout ile çağır:
        setTimeout(ensureOneChecked, 0);

    </script>

}
